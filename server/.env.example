# 模板 · 复制为 .env 后填写真实值
# cp .env.example .env

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vitalens

# 用下面的命令生成，然后粘贴进来：
#   openssl rand -hex 32    →  JWT_SECRET
#   openssl rand -hex 16    →  SMS_CODE_SALT
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_TTL_DAYS=30
SMS_CODE_SALT=CHANGE_ME_16_BYTES_HEX

# 短信：本地可用 mock；普通短信服务用 aliyun；号码认证服务 SendSmsVerifyCode 用 aliyun_pnvs
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=灵感果仓
SMS_TEMPLATE_ID=
SMS_REGION_ID=cn-hangzhou
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_SCHEME_NAME=
SMS_VALID_TIME=300

# 私有 OSS 图片资源
OSS_BUCKET=inspiration-images
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ASSET_PREFIX=miniprogram/assets
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
OSS_SIGNED_URL_TTL=3600

# ANTHROPIC_API_KEY=sk-ant-...

APP_ENV=dev
