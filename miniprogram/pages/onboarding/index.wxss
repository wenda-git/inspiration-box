/* ============ 整页 ============ */
.q-page {
  min-height: 100vh;
  position: relative;
  overflow: visible;
  background:
    radial-gradient(circle at 18% 4%, rgba(255, 255, 255, 0.96), rgba(250, 246, 239, 0) 34%),
    linear-gradient(180deg, #FBF7EF 0%, #F7F0E5 100%);
  display: flex;
  flex-direction: column;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}
.q-bg-deco {
  position: fixed;
  pointer-events: none;
  opacity: 0.18;
  z-index: 0;
}
.q-bg-deco-leaf {
  width: 430rpx;
  height: 430rpx;
  right: -132rpx;
  top: 112rpx;
  opacity: 0.22;
  transform: rotate(-16deg);
}
.q-bg-deco-citrus {
  width: 300rpx;
  height: 300rpx;
  right: -92rpx;
  bottom: 188rpx;
  opacity: 0.14;
}
.q-bg-deco-apple {
  width: 260rpx;
  height: 260rpx;
  left: -96rpx;
  bottom: 96rpx;
  opacity: 0.12;
}

/* ============ 顶栏 ============ */
.q-topbar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0 24rpx;
}
.q-back-txt {
  font-size: 28rpx;
  color: var(--vl-ink);
  padding: 8rpx 4rpx;
  min-width: 90rpx;
}
.q-back-muted {
  color: var(--vl-ink-2);
}
.q-progress {
  flex: 1;
  height: 32rpx;
  background: rgba(255, 253, 248, 0.86);
  border-radius: 999rpx;
  overflow: hidden;
  border: 1rpx solid rgba(150, 124, 87, 0.12);
}
.q-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #78A969 0%, #5E914F 100%);
  border-radius: 999rpx;
  transition: width 400ms var(--vl-ease);
}
.q-progress-pct {
  font-size: 26rpx;
  color: var(--vl-ink);
  font-weight: 500;
  min-width: 68rpx;
  text-align: right;
}

/* ============ 标题 ============ */
.q-body {
  position: relative;
  z-index: 1;
  flex: 1;
  padding-top: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.q-title-center {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--vl-ink);
  text-align: center;
  line-height: 1.3;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  justify-content: center;
}
.q-why-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid var(--vl-ink-3);
  color: var(--vl-ink-3);
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
  line-height: 1;
}
.q-subtitle-center {
  text-align: center;
  font-size: 26rpx;
  color: var(--vl-ink-2);
  margin-top: 16rpx;
}

/* ============ 性别：两个大圆 ============ */
.q-circles {
  margin-top: 120rpx;
  display: flex;
  gap: 36rpx;
  justify-content: center;
  width: 100%;
}
.q-circle {
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid rgba(150, 124, 87, 0.12);
  box-shadow: 0 12rpx 28rpx rgba(140, 103, 58, 0.10);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--vl-ink);
  font-weight: 500;
  transition: all 160ms var(--vl-ease);
}
.q-circle:active { transform: scale(0.96); }
.q-circle-on {
  background: linear-gradient(180deg, #6FA260 0%, #5A8E4C 100%);
  color: #FFFFFF;
  border-color: rgba(94, 145, 79, 0.42);
}

/* ============ 胶囊列表 ============ */
.q-pills {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  width: 100%;
}
.q-pill {
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid rgba(150, 124, 87, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(140, 103, 58, 0.08);
  border-radius: 999rpx;
  padding: 38rpx 48rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--vl-ink);
  font-weight: 500;
  transition: all 160ms var(--vl-ease);
}
.q-pill:active { transform: scale(0.98); }
.q-pill-on {
  background: linear-gradient(180deg, #6FA260 0%, #5A8E4C 100%);
  color: #FFFFFF;
  border-color: rgba(94, 145, 79, 0.42);
}

/* ============ 数字输入 ============ */
.q-num-wrap {
  margin-top: 120rpx;
  width: 100%;
}
.q-num-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}
.q-num-input-wrap {
  flex: 1;
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid rgba(150, 124, 87, 0.18);
  box-shadow: 0 10rpx 24rpx rgba(140, 103, 58, 0.08);
  border-radius: 999rpx;
  padding: 28rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.q-num-input {
  flex: 1;
  font-size: 32rpx;
  color: var(--vl-ink);
  background: transparent;
  text-align: center;
}
.q-num-unit {
  font-size: 28rpx;
  color: var(--vl-ink-2);
  margin-left: 12rpx;
}
.q-num-check {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #6FA260 0%, #5A8E4C 100%);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
  transition: opacity 160ms;
}
.q-num-check:active { transform: scale(0.94); }
.q-num-check-disabled {
  opacity: 0.4;
}
.q-num-hint {
  margin-top: 40rpx;
  font-size: 48rpx;
  color: var(--vl-ink);
  font-weight: 600;
  text-align: center;
  letter-spacing: 0.02em;
}

/* ============ tag 输入 ============ */
.q-tag-wrap {
  margin-top: 100rpx;
  width: 100%;
}
.q-tag-input {
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid rgba(150, 124, 87, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(140, 103, 58, 0.08);
  border-radius: 999rpx;
  padding: 36rpx 48rpx;
  font-size: 30rpx;
  color: var(--vl-ink);
  width: 100%;
  box-sizing: border-box;
  text-align: center;
}
.q-tag-hint {
  font-size: 24rpx;
  color: var(--vl-ink-2);
  margin-top: 16rpx;
  text-align: center;
}

/* ============ 底部按钮 ============ */
.q-footer {
  position: relative;
  z-index: 1;
  padding-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}
.q-btn {
  width: calc(100vw - 96rpx);
  max-width: 640rpx;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0;
  white-space: nowrap;
  overflow: hidden;
  box-sizing: border-box;
}
.q-btn::after { border: none; }
.q-btn-text {
  white-space: nowrap;
  line-height: 1;
}
.q-btn-primary {
  background: linear-gradient(180deg, #6FA260 0%, #5A8E4C 100%);
  color: #FFFFFF;
  box-shadow: 0 16rpx 34rpx rgba(83, 128, 70, 0.28);
}
.q-btn-primary:active { transform: scale(0.985); }
button.q-btn[disabled] { opacity: 0.4; }

.q-skip {
  font-size: 26rpx;
  color: var(--vl-ink-2);
  padding: 16rpx;
}

/* ============ why 弹窗 ============ */
.q-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
}
.q-why-card {
  background: #FFFDF8;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  max-width: 560rpx;
  border: 1rpx solid rgba(150, 124, 87, 0.12);
  box-shadow: 0 18rpx 44rpx rgba(64, 43, 28, 0.18);
}
.q-why-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--vl-ink);
  text-align: center;
}
.q-why-text {
  font-size: 28rpx;
  color: var(--vl-ink-2);
  line-height: 1.7;
  margin: 24rpx 0 32rpx;
  text-align: center;
}
.q-why-btn {
  background: linear-gradient(180deg, #6FA260 0%, #5A8E4C 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}
.q-why-btn:active { transform: scale(0.98); }

/* ============ 诊断页 ============ */
.diag-hero {
  background: rgba(255, 253, 248, 0.92);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  margin-top: 56rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  border: 1rpx solid rgba(150, 124, 87, 0.12);
  box-shadow: 0 14rpx 30rpx rgba(140, 103, 58, 0.10);
}
.diag-hero-label {
  font-size: 24rpx;
  color: var(--vl-ink-2);
  letter-spacing: 0.2em;
  text-transform: uppercase;
}
.diag-hero-title {
  font-size: 56rpx;
  color: var(--vl-ink);
  margin-top: 16rpx;
  font-weight: 600;
}
.diag-list {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}
.diag-row {
  background: rgba(255, 253, 248, 0.92);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(150, 124, 87, 0.10);
  box-shadow: 0 8rpx 20rpx rgba(140, 103, 58, 0.07);
}
.diag-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--vl-ink);
}
.diag-detail {
  font-size: 24rpx;
  color: var(--vl-ink-2);
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ============ 分组多选（过敏水果） ============ */
.q-groups {
  margin-top: 40rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-bottom: 32rpx;
}
.q-group-title {
  font-size: 24rpx;
  color: var(--vl-ink-2);
  letter-spacing: 0.16em;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}
.q-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.q-chip {
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid rgba(150, 124, 87, 0.12);
  box-shadow: 0 8rpx 18rpx rgba(140, 103, 58, 0.07);
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  color: var(--vl-ink);
  transition: all 160ms var(--vl-ease);
  line-height: 1.2;
}
.q-chip:active { transform: scale(0.96); }
.q-chip-on {
  background: linear-gradient(180deg, #6FA260 0%, #5A8E4C 100%);
  color: #FFFFFF;
  border-color: rgba(94, 145, 79, 0.42);
}

/* 分组题让 body 顶部留白小一些，内容更有呼吸 */
.q-body.q-body-compact {
  padding-top: 48rpx;
}

/* ============ 诊断页 · 方向选择 ============ */
.diag-plans-label {
  margin-top: 48rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--vl-ink-2);
  letter-spacing: 0.16em;
  font-weight: 600;
  padding-left: 8rpx;
  width: 100%;
  text-align: left;
  text-transform: uppercase;
}
.diag-plans {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.diag-plan {
  position: relative;
  background: rgba(255, 253, 248, 0.92);
  border-radius: 28rpx;
  padding: 28rpx 28rpx;
  border: 1rpx solid rgba(150, 124, 87, 0.12);
  box-shadow: 0 10rpx 24rpx rgba(140, 103, 58, 0.08);
  transition: all 180ms var(--vl-ease);
}
.diag-plan:active { transform: scale(0.98); }
.diag-plan-on {
  background: rgba(239, 247, 233, 0.96);
  border-color: rgba(94, 145, 79, 0.44);
}
.diag-plan-badge {
  position: absolute;
  top: -14rpx;
  right: 24rpx;
  background: #5E914F;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  letter-spacing: 0.1em;
}
.diag-plan-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.diag-plan-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #EFF7E9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.diag-plan-on .diag-plan-emoji {
  background: #FFFFFF;
}
.diag-plan-main {
  flex: 1;
  min-width: 0;
}
.diag-plan-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--vl-ink);
  letter-spacing: 0.02em;
}
.diag-plan-tag {
  font-size: 24rpx;
  color: var(--vl-ink-2);
  margin-top: 4rpx;
}
.diag-plan-price {
  text-align: right;
  flex-shrink: 0;
}
.diag-plan-price-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--vl-ink);
  font-feature-settings: "tnum";
}
.diag-plan-price-unit {
  font-size: 20rpx;
  color: var(--vl-ink-2);
  margin-top: 2rpx;
}
.diag-firstpay {
  font-size: 24rpx;
  color: var(--vl-ink-2);
  text-align: center;
  padding-bottom: 4rpx;
}
