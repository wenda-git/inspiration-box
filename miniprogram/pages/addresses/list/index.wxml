<view class="theme-matcha page-padding stack-6">

  <view class="stack-3">
    <view class="t-label">SHIP TO</view>
    <view class="t-h1 t-serif">收货地址</view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && addresses.length === 0}}" class="card-ghost stack-4" style="align-items: center; text-align: center; padding: 64rpx 32rpx;">
    <view style="font-size: 88rpx;">📭</view>
    <view class="t-h3">还没有收货地址</view>
    <view class="t-body">先加一个，冷链才知道往哪儿寄。</view>
  </view>

  <!-- 列表 -->
  <view class="stack-4" wx:else>
    <view
      wx:for="{{addresses}}"
      wx:key="id"
      class="card stack-3"
    >
      <view class="row-between">
        <view class="row" style="gap: 12rpx;">
          <view class="t-h3">{{item.receiver_name}}</view>
          <view class="t-body">{{item.receiver_phone}}</view>
        </view>
        <view wx:if="{{item.is_default}}" class="chip chip-brand">默认</view>
      </view>
      <view class="t-body">{{item.region}} {{item.detail}}</view>

      <view class="divider-dashed"></view>

      <view class="row" style="gap: 24rpx;">
        <view class="t-caption t-muted" bindtap="onEdit" data-id="{{item.id}}">编辑</view>
        <view wx:if="{{!item.is_default}}" class="t-caption t-brand" bindtap="onSetDefault" data-id="{{item.id}}">设为默认</view>
        <view class="grow"></view>
        <view class="t-caption t-danger" bindtap="onDelete" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="stack-4">
    <view class="skeleton" style="height: 220rpx;"></view>
    <view class="skeleton" style="height: 220rpx;"></view>
  </view>

  <button class="btn btn-primary btn-block" bindtap="onAdd">+ 新增地址</button>

</view>
