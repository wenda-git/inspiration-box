<view class="theme-matcha page-padding stack-5">
  <view class="stack-3">
    <view class="t-label">FEEDBACK HISTORY</view>
    <view class="t-h1 t-serif">你的<text style="font-style: italic;">每一次</text>反馈</view>
    <view class="t-body">AI 读完了，下周会朝你想要的方向走。</view>
  </view>

  <view wx:if="{{loading}}" class="stack-4">
    <view class="skeleton" style="height: 160rpx;"></view>
    <view class="skeleton" style="height: 160rpx;"></view>
  </view>

  <view wx:elif="{{list.length === 0}}" class="card-ghost stack-3" style="text-align: center; padding: 56rpx 32rpx;">
    <image src="{{assetBase}}/illustrations/empty-feedback.png" mode="aspectFit" style="width: 320rpx; height: 240rpx; margin: 0 auto 8rpx;"/>
    <view class="t-h3 t-serif">还没留下反馈</view>
    <view class="t-caption">收到箱子后来说说吃起来怎么样。</view>
  </view>

  <view wx:else class="stack-4">
    <view wx:for="{{list}}" wx:key="id" class="card stack-3">
      <view class="row" style="gap: 16rpx;">
        <view class="fruit-avatar">{{item.emoji}}</view>
        <view class="grow">
          <view class="row-between">
            <view class="t-h3">{{item.fruit_name_cn}}</view>
            <view class="t-caption t-mono" style="color: var(--vl-brand);">{{item.stars}}</view>
          </view>
          <view class="t-caption" style="margin-top: 4rpx;">{{item.kind_label}} · {{item.created_str}}</view>
        </view>
      </view>
      <view wx:if="{{item.comment}}" class="t-body" style="background: var(--vl-bg-soft); padding: 16rpx 20rpx; border-radius: var(--vl-r-md);">
        {{item.comment}}
      </view>
    </view>
  </view>
</view>
