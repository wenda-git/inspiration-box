<view class="theme-matcha page-padding stack-5">
  <view class="stack-3">
    <view class="t-label">ORDER HISTORY</view>
    <view class="t-h1 t-serif">你的<text style="font-style: italic;">水果历程</text></view>
  </view>

  <view wx:if="{{loading}}" class="stack-4">
    <view class="skeleton" style="height: 180rpx;"></view>
    <view class="skeleton" style="height: 180rpx;"></view>
  </view>

  <view wx:elif="{{orders.length === 0}}" class="card-ghost stack-3" style="text-align: center; padding: 56rpx 32rpx;">
    <image src="{{assetBase}}/illustrations/empty-orders.png" mode="aspectFit" style="width: 320rpx; height: 240rpx; margin: 0 auto 8rpx;"/>
    <view class="t-h3 t-serif">还没有订单</view>
    <view class="t-caption">付款后，每一箱都会记在这里。</view>
  </view>

  <view wx:else class="stack-4">
    <view wx:for="{{orders}}" wx:key="id" class="card stack-3" bindtap="onOrderTap" data-id="{{item.id}}">
      <view class="row-between">
        <view>
          <view class="t-label">{{item.week_text}}</view>
          <view class="t-h3 t-serif" style="margin-top: 4rpx;">{{item.plan_label}}</view>
        </view>
        <view class="chip chip-brand">{{item.status_label}}</view>
      </view>

      <view class="divider-dashed"></view>

      <view class="t-body">{{item.items_short || '—'}}</view>
      <view class="row-between">
        <view class="t-caption">{{item.item_count}} 种 · {{item.created_at_str}}</view>
        <view class="t-body t-mono t-ink">¥{{item.total_cost_cny}}</view>
      </view>

      <view wx:if="{{item.tracking_no}}" class="t-caption t-muted">
        顺丰 · {{item.tracking_no}}
      </view>
      <view class="t-caption t-muted">查看详情 ›</view>
    </view>
  </view>
</view>
