.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.step {
  position: relative;
  min-height: 88rpx;
  color: var(--muted);
}

.step::before {
  content: "";
  position: absolute;
  top: 16rpx;
  left: 34rpx;
  right: -10rpx;
  height: 2rpx;
  background: rgba(45, 36, 32, 0.12);
}

.step:last-child::before {
  display: none;
}

.step-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #E8E0D7;
  margin-bottom: 12rpx;
}

.step.done .step-dot {
  background: var(--brand);
}

.step.active .step-dot {
  box-shadow: 0 0 0 10rpx rgba(107, 158, 95, 0.12);
}

.step-label {
  font-size: 22rpx;
  line-height: 1.3;
}

.step.done {
  color: var(--ink);
}

.timeline-note {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.item-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(45, 36, 32, 0.08);
}

.item-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F0E8;
  font-size: 36rpx;
}
