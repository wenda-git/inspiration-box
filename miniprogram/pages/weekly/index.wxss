.home-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 16% 2%, rgba(255, 255, 255, 0.96), rgba(250, 246, 239, 0) 34%),
    linear-gradient(180deg, #FBF7EF 0%, #F7F0E5 100%);
}

.home-bg-deco {
  position: fixed;
  pointer-events: none;
  opacity: 0.22;
  z-index: 0;
}
.home-bg-deco-leaf {
  width: 440rpx;
  height: 440rpx;
  right: -120rpx;
  top: 168rpx;
  opacity: 0.28;
  transform: rotate(-16deg);
}
.home-bg-deco-citrus {
  width: 330rpx;
  height: 330rpx;
  right: -92rpx;
  bottom: 300rpx;
  opacity: 0.18;
}
.home-bg-deco-apple {
  width: 300rpx;
  height: 300rpx;
  left: -110rpx;
  bottom: 180rpx;
  opacity: 0.16;
}

.home-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, rgba(251, 247, 239, 0.98), rgba(251, 247, 239, 0.72));
  backdrop-filter: blur(18rpx);
  z-index: 100;
}
.home-nav-inner {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-right: 220rpx;
  box-sizing: border-box;
}
.home-nav-logo {
  height: 84rpx;
  width: 318rpx;
}

.home-scroll {
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}
.home-section {
  padding: 40rpx 16rpx 236rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.home-greeting {
  padding: 18rpx 16rpx 10rpx;
}
.home-greeting-title {
  font-family: var(--vl-font-serif);
  font-size: 50rpx;
  line-height: 1.16;
  color: var(--vl-ink);
  font-weight: 600;
  letter-spacing: 0;
}
.home-greeting-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #6F675E;
  letter-spacing: 0.02em;
}

.home-hero {
  position: relative;
  min-height: 586rpx;
  border-radius: 34rpx;
  overflow: visible;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.94) 0%, rgba(250,246,239,0.86) 46%, rgba(239,229,211,0.72) 100%);
  border: 2rpx solid rgba(255,255,255,0.88);
  box-shadow: 0 18rpx 38rpx rgba(140, 103, 58, 0.14);
}
.home-hero::after {
  content: "";
  position: absolute;
  inset: 10rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(133, 112, 82, 0.08);
  pointer-events: none;
}
.home-hero:active { transform: scale(0.992); }
.home-hero-leaf {
  display: none;
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  right: -28rpx;
  top: -20rpx;
  opacity: 0.24;
  transform: rotate(12deg);
}
.home-hero-content {
  position: absolute;
  left: 46rpx;
  top: 76rpx;
  width: 360rpx;
  z-index: 2;
}
.home-hero-title {
  font-family: var(--vl-font-serif);
  font-size: 60rpx;
  line-height: 1.06;
  color: var(--vl-ink);
  font-weight: 500;
  letter-spacing: 0;
}
.home-hero-sub {
  margin-top: 26rpx;
  font-size: 24rpx;
  line-height: 1.62;
  color: #514942;
  max-width: 320rpx;
}
.home-hero-cta {
  margin-top: 30rpx;
  height: 70rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #75A665 0%, #5E914F 100%);
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 14rpx 28rpx rgba(83, 128, 70, 0.32);
}
.home-hero-arrow {
  font-size: 34rpx;
  line-height: 1;
}
.home-box-image {
  position: absolute;
  right: -52rpx;
  top: -34rpx;
  width: 500rpx;
  height: 376rpx;
  z-index: 1;
}

.home-chips {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  min-height: 106rpx;
  background: rgba(255, 253, 248, 0.88);
  border: 1rpx solid rgba(150, 124, 87, 0.18);
  border-radius: 28rpx;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(140, 103, 58, 0.08);
}
.home-chip {
  min-width: 0;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-right: 1rpx solid rgba(123, 105, 83, 0.18);
}
.home-chip:last-child { border-right: none; }
.home-chip-ico {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(91, 135, 76, 0.38);
  color: #5E914F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  font-family: var(--vl-font-mono);
}
.home-chip-ico-truck {
  width: 30rpx;
  height: 20rpx;
  border: 3rpx solid #5E914F;
  border-radius: 4rpx 8rpx 4rpx 4rpx;
  position: relative;
}
.home-chip-ico-truck::after {
  content: "";
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  bottom: -10rpx;
  height: 7rpx;
  background: radial-gradient(circle at 20% 50%, #5E914F 50%, transparent 52%),
              radial-gradient(circle at 80% 50%, #5E914F 50%, transparent 52%);
}
.home-chip-ico-cal {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #5E914F;
  border-radius: 5rpx;
  position: relative;
}
.home-chip-ico-cal::before {
  content: "";
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  top: -7rpx;
  height: 5rpx;
  background: #5E914F;
  border-radius: 4rpx;
}
.home-chip-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--vl-ink);
  white-space: nowrap;
}
.home-chip-sub {
  margin-top: 2rpx;
  font-size: 18rpx;
  line-height: 1.25;
  color: #8B8176;
  max-width: none;
  white-space: nowrap;
}

.home-learning-card {
  position: relative;
  min-height: 138rpx;
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #312721 0%, #4E3C2D 58%, #5C7B46 100%);
  color: #FFFFFF;
  box-shadow: 0 14rpx 30rpx rgba(64, 43, 28, 0.18);
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.home-learning-card::after {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -70rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}
.home-learning-card:active { transform: scale(0.99); }
.home-learning-mark {
  position: relative;
  z-index: 1;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 34rpx;
}
.home-learning-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}
.home-learning-kicker {
  font-size: 20rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.62);
  font-family: var(--vl-font-mono);
  letter-spacing: 0.04em;
}
.home-learning-title {
  margin-top: 4rpx;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #FFFFFF;
}
.home-learning-summary {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.36;
  color: rgba(255, 255, 255, 0.76);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.home-learning-more {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
}

.home-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.home-card {
  position: relative;
  min-height: 238rpx;
  padding: 20rpx 20rpx 16rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid rgba(150, 124, 87, 0.10);
  box-shadow: 0 10rpx 24rpx rgba(140, 103, 58, 0.09);
}
.home-card::after {
  content: "";
  position: absolute;
  right: -48rpx;
  bottom: -52rpx;
  width: 190rpx;
  height: 190rpx;
  background: rgba(232, 240, 225, 0.42);
  border-radius: 50%;
  z-index: 0;
}
.home-card::before {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 50%;
  z-index: 0;
  pointer-events: none;
}
.home-card:active { transform: scale(0.985); }
.home-card-head {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-card-title {
  font-family: var(--vl-font-serif);
  font-size: 36rpx;
  line-height: 1.16;
  font-weight: 600;
  color: var(--vl-ink);
}
.home-card-arrow {
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid rgba(120, 103, 78, 0.28);
  border-radius: 50%;
  color: #9C927F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 30rpx;
}
.home-card-img {
  position: absolute;
  z-index: 1;
  pointer-events: none;
  object-fit: contain;
  opacity: 0.96;
}
.home-card-img-basket {
  right: -42rpx !important;
  bottom: 8rpx !important;
  width: 300rpx !important;
  height: 240rpx !important;
}
.home-card-img-kiwi {
  right: -46rpx !important;
  bottom: -26rpx !important;
  width: 348rpx !important;
  height: 278rpx !important;
}
.home-card-img-calendar {
  right: -34rpx !important;
  bottom: 0 !important;
  width: 246rpx !important;
  height: 196rpx !important;
}
.home-card-img-mood {
  right: -62rpx !important;
  bottom: 0 !important;
  width: 322rpx !important;
  height: 257rpx !important;
}
.home-card-foot {
  position: absolute;
  z-index: 3;
  left: 20rpx;
  right: auto;
  top: 76rpx;
  width: 180rpx;
}
.home-card-sub {
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--vl-ink);
  font-weight: 500;
}
.home-card-desc {
  margin-top: 6rpx;
  max-width: 180rpx;
  font-size: 22rpx;
  line-height: 1.38;
  color: #746A61;
}
.home-card-price,
.home-card-emphasis {
  margin-top: 6rpx;
  font-family: var(--vl-font-mono);
  font-size: 28rpx;
  color: #5E914F;
  font-weight: 700;
}

.home-floating-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 48rpx calc(92rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(250, 246, 239, 0) 0%, rgba(250, 246, 239, 0.96) 42%);
  z-index: 50;
}
.home-pay-btn {
  width: 100%;
  height: 96rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #6FA260 0%, #5A8E4C 100%);
  color: #FFFFFF;
  box-shadow: 0 16rpx 34rpx rgba(83, 128, 70, 0.30);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}
.home-pay-btn::after { border: none; }
.home-pay-btn:active { transform: scale(0.985); }
.home-pay-price {
  font-family: var(--vl-font-mono);
  font-weight: 700;
}
